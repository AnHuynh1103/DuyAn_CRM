<odoo>
  <data>
    <record id="view_dac_sales_goal_list" model="ir.ui.view">
      <field name="name">dac.sales.goal.list</field>
      <field name="model">dac.sales.goal</field>
      <field name="arch" type="xml">
        <list string="Mục tiêu/KPI" create="true" edit="true">
          <field name="goal_scope"/>
          <field name="team_id" optional="show"/>
          <field name="user_id" optional="show"/>
          <field name="company_id"/>
          <field name="year"/>
          <field name="month"/>
          <field name="target_amount"/>
          <field name="kpi_cared_count" optional="hide"/>
          <field name="kpi_quotation_count" optional="hide"/>
          <field name="kpi_closed_count" optional="hide"/>
          <field name="kpi_completed_customer_count" optional="hide"/>
          <field name="active"/>
          <field name="note" optional="hide"/>
        </list>
      </field>
    </record>

      <!-- ===== LIST/FORM (dac.sales.goal.member) – view riêng ===== -->
      <record id="view_dac_sales_goal_member_list" model="ir.ui.view">
          <field name="name">dac.sales.goal.member.list</field>
          <field name="model">dac.sales.goal.member</field>
          <field name="arch" type="xml">
            <list string="Phân bổ thành viên" editable="bottom">
              <field name="user_id"/>
              <field name="member_target_amount"/>
              <field name="note" optional="hide"/>
            </list>
          </field>
      </record>

      <record id="view_dac_sales_goal_member_form" model="ir.ui.view">
          <field name="name">dac.sales.goal.member.form</field>
          <field name="model">dac.sales.goal.member</field>
          <field name="arch" type="xml">
            <form string="Phân bổ thành viên">
              <group>
                <field name="user_id"/>
                <field name="member_target_amount"/>
                <field name="note"/>
              </group>
            </form>
          </field>
      </record>




    <record id="view_dac_sales_goal_form" model="ir.ui.view">
      <field name="name">dac.sales.goal.form</field>
      <field name="model">dac.sales.goal</field>
      <field name="arch" type="xml">
        <form string="Mục tiêu doanh thu / KPI">
          <sheet>
            <group>
              <group>
                <field name="goal_scope"/>
                <!-- Hiện & bắt buộc nếu scope=user -->
                <field name="user_id"
                       modifiers="{&quot;required&quot;: [[&quot;goal_scope&quot;,&quot;=&quot;,&quot;user&quot;]],
                                   &quot;invisible&quot;: [[&quot;goal_scope&quot;,&quot;!=&quot;,&quot;user&quot;]]}"/>
                <!-- Hiện & bắt buộc nếu scope=team -->
                <field name="team_id"
                       modifiers="{&quot;required&quot;: [[&quot;goal_scope&quot;,&quot;=&quot;,&quot;team&quot;]],
                                   &quot;invisible&quot;: [[&quot;goal_scope&quot;,&quot;!=&quot;,&quot;team&quot;]]}"/>
                <field name="company_id"/>
                <field name="year"/>
                <field name="month"/>
                <field name="active"/>
              </group>
              <group string="Mục tiêu chính">
                <field name="target_amount"/>
                <field name="note"/>
              </group>
            </group>

            <notebook>
              <page string="KPI (chỉ tiêu số lượng)">
                <group>
                  <field name="kpi_cared_count"/>
                  <field name="kpi_quotation_count"/>
                  <field name="kpi_closed_count"/>
                  <field name="kpi_completed_customer_count"/>
                </group>
              </page>

              <page string="Trọng số KPI">
                <group>
                  <field name="weight_revenue" help="VD: 1.0 = 100%; 0.5 = 50%"/>
                  <field name="weight_cared"/>
                  <field name="weight_quotation"/>
                  <field name="weight_closed"/>
                  <field name="weight_completed"/>
                </group>
              </page>

              <page string="Phân bổ thành viên"
                    modifiers="{&quot;invisible&quot;: [[&quot;goal_scope&quot;,&quot;!=&quot;,&quot;team&quot;]]}">
                <group>
                  <field name="member_line_ids"
                         mode="list,form"
                         views="{
                            'list': 'dac_report.view_dac_sales_goal_member_list',
                            'form': 'dac_report.view_dac_sales_goal_member_form'
                          }"
                         options="{'no_open': True}"/>
                </group>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_dac_sales_goal" model="ir.actions.act_window">
      <field name="name">Mục tiêu doanh thu</field>
      <field name="res_model">dac.sales.goal</field>
      <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dac_sales_goal"
              parent="home_menu.home_root"
              action="action_dac_sales_goal"
              sequence="200"/>  
  </data>
</odoo>
