<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- Bản ghi dashboard duy nhất -->
    <record id="dac_report_dashboard_record" model="dac.report.dashboard">
      <field name="name">Báo cáo doanh thu</field>
    </record>

    <!-- FORM hiển thị các thẻ số liệu -->
    <record id="dac_report_dashboard_view_form" model="ir.ui.view">
      <field name="name">dac.report.dashboard.view.form</field>
      <field name="model">dac.report.dashboard</field>
      <field name="arch" type="xml">
        <form create="0" edit="0">
          <sheet>
            <field name="currency_id" invisible="1"/>
            <div class="dac-cards">
              <button type="object" name="action_open_quotes" class="dac-card dac-info">
                <div class="dac-card-title">
                  <i class="fa fa-file-text-o"/> Doanh thu báo giá
                </div>
                <div class="dac-card-value">
                  <field name="quote_amount" widget="monetary"
                        options="{'currency_field': 'currency_id'}"/>
                </div>
              </button>

              <button type="object" name="action_open_expected" class="dac-card dac-warning">
                <div class="dac-card-title"><i class="fa fa-line-chart"/> Doanh thu dự kiến</div>
                <div class="dac-card-value">
                  <field name="expected_amount" widget="monetary"
                        options="{'currency_field': 'currency_id'}"/>
                </div>
              </button>

              <button type="object" name="action_open_total" class="dac-card dac-success">
                <div class="dac-card-title"><i class="fa fa-money"/> Doanh thu tổng</div>
                <div class="dac-card-value">
                  <field name="total_amount" widget="monetary"
                        options="{'currency_field': 'currency_id'}"/>
                </div>
                <div class="dac-card-sub">
                  Đã thu: <field name="paid_amount" widget="monetary"
                                options="{'currency_field': 'currency_id'}"/>
                </div>
              </button>
            </div>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Action mở đúng bản ghi dashboard -->
    <record id="dac_report_dashboard_action" model="ir.actions.act_window">
        <field name="name">Báo cáo doanh thu</field>
        <field name="res_model">dac.report.dashboard</field>
        <field name="view_mode">form</field>
        <field name="views" eval="[(ref('dac_report.dac_report_dashboard_view_form'), 'form')]"/>
        <field name="res_id" ref="dac_report.dac_report_dashboard_record"/>  <!-- quan trọng -->
        <field name="target">current</field>
    </record>

  </data>
</odoo>
