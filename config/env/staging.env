# ==================== ODOO STAGING ENVIRONMENT ====================
# Database
POSTGRES_DB=staging_crm
POSTGRES_USER=odoo_staging
POSTGRES_PASSWORD=odoo_staging
POSTGRES_HOST=postgres-staging
POSTGRES_PORT=5432

# Odoo
ODOO_DATABASE=staging_crm
ODOO_USER=admin
ODOO_PASSWORD=staging123
ODOO_EMAIL=staging@duyan.vn

# Server
HOST=staging.duyan.vn
HTTP_PORT=8069
LONGPOLLING_PORT=8072

# Email Configuration (sử dụng test email hoặc dev email)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=staging-email@gmail.com
EMAIL_PASSWORD=staging-app-password
EMAIL_USE_TLS=True

# Security
SECRET_KEY=your-staging-secret-key-here
ADMIN_PASSWD=staging-master-password

# N8N Staging
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=staging123
N8N_HOST=staging-n8n.duyan.vn
WEBHOOK_URL=https://staging-n8n.duyan.vn/
N8N_PROTOCOL=https
N8N_PORT=5678

# Logging (verbose hơn cho debug)
LOG_LEVEL=DEBUG
LOG_HANDLER=:DEBUG
LOG_DB=True
LOG_DB_LEVEL=INFO
