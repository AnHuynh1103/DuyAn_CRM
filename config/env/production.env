# ==================== ODOO PRODUCTION ENVIRONMENT ====================
# Database
POSTGRES_DB=production_crm
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Odoo
ODOO_DATABASE=production_crm
ODOO_USER=admin
ODOO_PASSWORD=admin123
ODOO_EMAIL=admin@duyan.vn

# Server
HOST=crm.duyan.vn
HTTP_PORT=8069
LONGPOLLING_PORT=8072

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Security
SECRET_KEY=your-production-secret-key-here
ADMIN_PASSWD=admin-master-password

# N8N
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123
N8N_HOST=n8n.tuankiet.media
WEBHOOK_URL=https://n8n.tuankiet.media/
N8N_PROTOCOL=https
N8N_PORT=5678

# Logging
LOG_LEVEL=INFO
LOG_HANDLER=:INFO
LOG_DB=False
LOG_DB_LEVEL=WARNING
