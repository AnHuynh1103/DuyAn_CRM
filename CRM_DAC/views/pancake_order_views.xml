<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_pancake_order_list" model="ir.ui.view">
        <field name="name">pancake.order.list</field>
        <field name="model">pancake.order</field>
        <field name="arch" type="xml">
            <list string="Pancake Orders">
                <!-- <sheet> -->
                <header>
                    <button name="action_sync_pancake_all_orders" type="object" string="Sync All" class="oe_highlight"/>
                </header>
                <!-- </sheet> -->
                <!-- <button name="action_sync_pancake_all_orders" type="object" string="Hành động Tree View Mới" class="btn btn-primary open_wizard_action"/> -->
                <field name="name"/>
                <field name="pancake_order_id"/>
                <field name="pancake_customer_name"/>
                <field name="pancake_status_name"/>
                <field name="pancake_inserted_at"/>
                <field name="pancake_money_to_collect"/>
            </list>
        </field>
    </record>

    <record id="view_pancake_order_form" model="ir.ui.view">
        <field name="name">pancake.order.form</field>
        <field name="model">pancake.order</field>
        <field name="arch" type="xml">
            <form string="Pancake Order">
                <header>
                    <button name="action_sync_pancake_orders" type="object"
                            string="Đồng bộ từ Pancak" class="oe_highlight"/>
                    <button name="action_sync_pancake_orders" type="object"
                            string="test" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="pancake_order_id"/>
                    </group>
                    <notebook>
                        <page string="Chi tiết đơn hàng">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="pancake_product_name"/>
                                    <field name="pancake_quantity"/>
                                    <field name="pancake_price_unit"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_pancake_order" model="ir.actions.act_window">
        <field name="name">Đơn hàng Pancake</field>
        <field name="res_model">pancake.order</field>
        <field name="view_mode">list,form</field>
        </record>

    <!-- <menuitem id="menu_pancake_root" name="Pancake Integration" sequence="10"/>
    <menuitem id="menu_pancake_orders" name="Đơn hàng Pancake" parent="menu_pancake_root"
              action="action_pancake_order" sequence="1"/> -->
</odoo>