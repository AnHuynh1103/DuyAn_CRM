<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- A) Ẩn cột Thuế: PDF -->
    <template id="dac_report_invoice_hide_tax_base" inherit_id="account.report_invoice_document">
      <xpath expr="//div[contains(@class,'page')][1]" position="before">
        <t>
          <style type="text/css">
            table[name="invoice_line_table"] thead th:nth-child(4),
            table[name="invoice_line_table"] tbody td:nth-child(4) { display: none !important; }
            table.o_main_table thead th:nth-child(4),
            table.o_main_table tbody td:nth-child(4) { display: none !important; }
            th[name="taxes"], td[name="taxes"] { display: none !important; }
          </style>
        </t>
      </xpath>
    </template>

    <!-- B) Ẩn cột Thuế: Preview -->
    <template id="dac_report_invoice_hide_tax_preview" inherit_id="account.report_invoice_document_preview">
      <xpath expr="//div[contains(@class,'page')][1]" position="before">
        <t>
          <style type="text/css">
            table[name="invoice_line_table"] thead th:nth-child(4),
            table[name="invoice_line_table"] tbody td:nth-child(4) { display: none !important; }
            table.o_main_table thead th:nth-child(4),
            table.o_main_table tbody td:nth-child(4) { display: none !important; }
            th[name="taxes"], td[name="taxes"] { display: none !important; }
          </style>
        </t>
      </xpath>
    </template>

    <!-- Đổi tiêu đề cho PDF -->
    <template id="dac_invoice_title_base" inherit_id="account.report_invoice_document">
      <xpath expr="//t[@t-set='layout_document_title']" position="replace">
        <t t-set="layout_document_title">
          <!-- <span t-if="not proforma"></span>
          <span t-else="">PROFORMA</span> -->

          <!-- Outbound invoice: dùng PHIẾU THU cho mọi trạng thái -->
          <span t-if="o.move_type == 'out_invoice'">PHIẾU THU</span>

          <!-- Giữ nguyên các loại chứng từ khác -->
          <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'">Credit Note</span>
          <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'">Draft Credit Note</span>
          <span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">Cancelled Credit Note</span>
          <span t-elif="o.move_type == 'in_refund'">Vendor Credit Note</span>
          <span t-elif="o.move_type == 'in_invoice'">Vendor Bill</span>

          <!-- Số chứng từ -->
          <span t-if="o.name != '/'" t-field="o.name"/>
        </t>
      </xpath>
    </template>

    <!-- Đổi tiêu đề cho Preview (kế thừa từ base, nhưng thêm cho chắc chắn) -->
    <template id="dac_invoice_title_preview" inherit_id="account.report_invoice_document_preview">
      <xpath expr="//t[@t-set='layout_document_title']" position="replace">
        <t t-set="layout_document_title">
          <!-- <span t-if="not proforma"></span>
          <span t-else="">PROFORMA</span> -->
          <span t-if="o.move_type == 'out_invoice'">PHIẾU THU</span>
          <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'">Credit Note</span>
          <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'">Draft Credit Note</span>
          <span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">Cancelled Credit Note</span>
          <span t-elif="o.move_type == 'in_refund'">Vendor Credit Note</span>
          <span t-elif="o.move_type == 'in_invoice'">Vendor Bill</span>
          <span t-if="o.name != '/'" t-field="o.name"/>
        </t>
      </xpath>
    </template>

    <!-- Thay ' on ' -> ' trên ' trong tổng thuế (mặc định) -->
    <template id="dac_tax_on_vi"
              inherit_id="account.document_tax_totals_template">
      <xpath expr="//span[normalize-space(text())='on']" position="replace">
        <span> trên </span>
      </xpath>
    </template>

    <!-- Và trong template tổng thuế hiển thị theo tiền công ty -->
    <template id="dac_tax_on_vi_company"
              inherit_id="account.document_tax_totals_company_currency_template">
      <xpath expr="//span[normalize-space(text())='on']" position="replace">
        <span> trên </span>
      </xpath>
    </template>

  </data>
</odoo>
