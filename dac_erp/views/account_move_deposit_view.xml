<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit view hóa đơn để thêm nút "Đơn hàng" -->
        <record id="account_move_form_inherit_dac" model="ir.ui.view">
            <field name="name">account.move.form.inherit.dac</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Thêm nút "Đơn hàng" vào button box -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_back_to_sale_order" 
                            type="object"
                            class="oe_stat_button"
                            icon="fa-shopping-cart"
                            string="Đơn hàng"
                            help="Quay về đơn hàng"
                            invisible="not invoice_origin"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
