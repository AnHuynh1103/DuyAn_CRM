<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List View for Pancake Conversations -->
        <record id="pancake_conversation_view_list" model="ir.ui.view">
            <field name="name">pancake.conversation.list</field>
            <field name="model">pancake.conversation</field>
            <field name="arch" type="xml">
                <list string="Cuộc hội thoại Pancake" default_order="last_message_time desc">
                    <field name="name"/>
                    <field name="customer_name"/>
                    <field name="customer_phone"/>
                    <field name="platform"/>
                    <field name="last_message_content"/>
                    <field name="last_message_time"/>
                    <field name="assigned_staff_name"/>
                    <field name="status" widget="badge"/>
                    <field name="message_count"/>
                    <field name="last_sync_time"/>
                </list>
            </field>
        </record>

        <!-- Form View for Pancake Conversations -->
        <record id="pancake_conversation_view_form" model="ir.ui.view">
            <field name="name">pancake.conversation.form</field>
            <field name="model">pancake.conversation</field>
            <field name="arch" type="xml">
                <form string="Cuộc hội thoại Pancake">
                    <header>
                        <button name="action_sync_from_pancake" type="object" string="Đồng bộ từ Pancake" class="btn-primary"/>
                        <button name="action_sync_messages" type="object" string="Đồng bộ tin nhắn" class="btn-secondary"/>
                        <field name="status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_messages" type="object" class="oe_stat_button" icon="fa-comments">
                                <field name="message_count" widget="statinfo" string="Tin nhắn"/>
                            </button>
                        </div>
                        
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group name="conversation_info" string="Thông tin cuộc hội thoại">
                                <field name="conversation_id"/>
                                <field name="shop_id"/>
                                <field name="platform"/>
                                <field name="partner_id"/>
                            </group>
                            
                            <group name="customer_info" string="Thông tin khách hàng">
                                <field name="customer_name"/>
                                <field name="customer_phone"/>
                                <field name="customer_email"/>
                                <field name="customer_id_pancake"/>
                            </group>
                        </group>
                        
                        <group>
                            <group name="message_info" string="Tin nhắn cuối">
                                <field name="last_message_content"/>
                                <field name="last_message_time"/>
                                <field name="last_message_sender"/>
                            </group>
                            
                            <group name="staff_info" string="Nhân viên phụ trách">
                                <field name="assigned_staff_id"/>
                                <field name="assigned_staff_name"/>
                            </group>
                        </group>
                        
                        <group>
                            <group name="sync_info" string="Thông tin đồng bộ">
                                <field name="last_sync_time"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Tin nhắn">
                                <field name="message_ids" readonly="1">
                                    <list>
                                        <field name="timestamp"/>
                                        <field name="sender_name"/>
                                        <field name="sender_type"/>
                                        <field name="message_type"/>
                                        <field name="content"/>
                                    </list>
                                </field>
                            </page>
                            
                            <page string="Dữ liệu thô">
                                <field name="raw_data" widget="text"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View for Pancake Conversations -->
        <record id="pancake_conversation_view_search" model="ir.ui.view">
            <field name="name">pancake.conversation.search</field>
            <field name="model">pancake.conversation</field>
            <field name="arch" type="xml">
                <search string="Tìm kiếm cuộc hội thoại">
                    <field name="name"/>
                    <field name="customer_name"/>
                    <field name="customer_phone"/>
                    <field name="conversation_id"/>
                    <field name="platform"/>
                    <field name="assigned_staff_name"/>
                    
                    <filter string="Đang hoạt động" name="active" domain="[('status', '=', 'active')]"/>
                    <filter string="Đã lưu trữ" name="archived" domain="[('status', '=', 'archived')]"/>
                    <filter string="Đã đóng" name="closed" domain="[('status', '=', 'closed')]"/>
                    
                    <separator/>
                    <filter string="Hôm nay" name="today" domain="[('last_message_time', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter string="Tuần này" name="this_week" domain="[('last_message_time', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    
                    <group expand="1" string="Nhóm theo">
                        <filter string="Trạng thái" name="group_by_status" context="{'group_by': 'status'}"/>
                        <filter string="Nền tảng" name="group_by_platform" context="{'group_by': 'platform'}"/>
                        <filter string="Nhân viên" name="group_by_staff" context="{'group_by': 'assigned_staff_name'}"/>
                        <filter string="Ngày" name="group_by_date" context="{'group_by': 'last_message_time:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- list View for Messages -->
        <record id="pancake_conversation_message_view_list" model="ir.ui.view">
            <field name="name">pancake.conversation.message.list</field>
            <field name="model">pancake.conversation.message</field>
            <field name="arch" type="xml">
                <list string="Tin nhắn cuộc hội thoại">
                    <field name="timestamp"/>
                    <field name="conversation_id"/>
                    <field name="sender_name"/>
                    <field name="sender_type" widget="badge"/>
                    <field name="message_type" widget="badge"/>
                    <field name="content"/>
                </list>
            </field>
        </record>

        <!-- Form View for Messages -->
        <record id="pancake_conversation_message_view_form" model="ir.ui.view">
            <field name="name">pancake.conversation.message.form</field>
            <field name="model">pancake.conversation.message</field>
            <field name="arch" type="xml">
                <form string="Tin nhắn">
                    <sheet>
                        <group>
                            <group>
                                <field name="message_id"/>
                                <field name="conversation_id"/>
                                <field name="timestamp"/>
                            </group>
                            <group>
                                <field name="sender_name"/>
                                <field name="sender_type"/>
                                <field name="message_type"/>
                                <field name="staff_id"/>
                            </group>
                        </group>
                        
                        <group>
                            <field name="content" widget="text"/>
                        </group>
                        
                        <group string="Đính kèm" invisible="not attachment_url">
                            <field name="attachment_url"/>
                            <field name="attachment_name"/>
                        </group>
                        
                        <group string="Dữ liệu thô">
                            <field name="raw_data" widget="text"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for Pancake Conversations -->
        <record id="pancake_conversation_action" model="ir.actions.act_window">
            <field name="name">Cuộc hội thoại Pancake</field>
            <field name="res_model">pancake.conversation</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="pancake_conversation_view_list"/>
            <field name="search_view_id" ref="pancake_conversation_view_search"/>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo cuộc hội thoại Pancake đầu tiên của bạn!
                </p>
                <p>
                    Quản lý các cuộc hội thoại từ Pancake và đồng bộ tin nhắn.
                </p>
            </field>
        </record>

        <!-- Action for Messages -->
        <record id="pancake_conversation_message_action" model="ir.actions.act_window">
            <field name="name">Tin nhắn Pancake</field>
            <field name="res_model">pancake.conversation.message</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="pancake_conversation_message_view_list"/>
        </record>

        <!-- Action method for sync all conversations -->
        <record id="action_sync_all_pancake_conversations" model="ir.actions.server">
            <field name="name">Đồng bộ tất cả cuộc hội thoại từ Pancake</field>
            <field name="model_id" ref="model_pancake_conversation"/>
            <field name="state">code</field>
            <field name="code">
result = model.sync_all_conversations_from_pancake()
action = result
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="pancake_menu_root"
                  name="Pancake"
                  sequence="20"/>

        <menuitem id="pancake_conversation_menu"
                  name="Cuộc hội thoại"
                  parent="pancake_menu_root"
                  action="pancake_conversation_action"
                  sequence="10"/>

        <menuitem id="pancake_conversation_message_menu"
                  name="Tin nhắn"
                  parent="pancake_menu_root"
                  action="pancake_conversation_message_action"
                  sequence="20"/>

        <menuitem id="pancake_sync_menu"
                  name="Đồng bộ tất cả"
                  parent="pancake_menu_root"
                  action="action_sync_all_pancake_conversations"
                  sequence="30"/>

    </data>
</odoo>
