<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_order_inherit_view_form" model="ir.ui.view">
            <field name="name">sale.order.inherit.form</field>
            <field name="model">sale.order</field>
            <field name="priority">16</field> <!-- Ưu tiên view này -->
            <field name="arch" type="xml">
                <form>
                    <header>
                        <div style="display: flex; align-items: center;">
                            <div>
                                <field name="order_state_custom" widget="statusbar"/>
                            </div>
                        </div>
                        <!-- Các nút demo sẽ tự động nằm bên phải header -->
                    </header>
                    <sheet>
                        <group col="4">
                            <group>
                                <h1>
                                    <field name="name" readonly="1" string="Tạo đơn mới"/>
                                </h1>
                                <field name="partner_id" style="min-width: 300px;"/>
                                <field name="date" style="min-width: 200px;"/>
                                <field name="validity_date" style="min-width: 200px;"/>
                                <field name="user_id" invisible="1"/>
                                <field name="team_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Chi tiết đơn hàng">
                                <field name="order_line"
                                       create="1"
                                       delete="1"
                                       options="{'no_open': True, 'no_create_edit': True, 'no_create': True}">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="product_uom_qty"/>
                                        <field name="price_unit"/>
                                        <field name="tax_id" widget="many2many_tags"/>
                                        <field name="price_subtotal" readonly="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <div style="text-align: left; margin-top: 24px;">
                            <field name="note" placeholder="Ghi chú" nolabel="1"/>
                        </div>
                        <div style="text-align: right; margin-top: 16px;">
                            <div>
                                <label for="amount_untaxed">Số tiền trước thuế:</label>
                                <span style="font-weight: bold; margin-left: 16px;">
                                    <field name="amount_untaxed" readonly="1" widget="monetary"/>
                                    <span> đ</span>
                                </span>
                            </div>
                            <div>
                                <label for="amount_tax">Thuế:</label>
                                <span style="font-weight: bold; margin-left: 16px;">
                                    <field name="amount_tax" readonly="1" widget="monetary"/>
                                    <span> đ</span>
                                </span>
                            </div>
                            <div>
                                <span style="font-weight: bold; font-size: 1.5em;">
                                    Tổng:
                                    <field name="amount_total" readonly="1" widget="monetary"/>
                                    <span> đ</span>
                                </span>
                            </div>
                            <div style="text-align: right; margin-top: 16px;">
                                <button name="action_save_custom"
                                    string="Lưu" 
                                    type="object"  
                                    class="btn-primary"
                                    style="margin: 0 16px 0 0;"/>
                                <button name="action_confirm_custom"
                                    string="Xác nhận"
                                    type="object"
                                    class="btn-secondary"
                                    style="margin-left: 12px;"/>
                            </div>
                        </div>
                        
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="sale_order_inherit_view_list" model="ir.ui.view">
            <field name="name">sale.order.inherit.list</field>
            <field name="model">sale.order</field>
            <field name="priority">16</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="create_date"/>
                    <field name="partner_id"/>
                    <field name="user_id"/>
                    <field name="activity_ids"/>
                    <field name="amount_total"/>
                    <field name="order_state_custom"/>
                </list>
            </field>
        </record>

        <record id="sale_order_inherit_action" model="ir.actions.act_window">
            <field name="name">Báo giá</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="sale.view_quotation_tree_with_onboarding"/> <!-- view list mặc định của Odoo -->
            <field name="context">{}</field>
        </record>

        <menuitem id="sale_order_inherit_menu_root"
            name="Sale Orders"
            parent="home_menu.home_root"
            sequence="10"/>

        <menuitem id="sale_order_inherit_menu_list"
            name="Sale Orders List"
            parent="sale_order_inherit_menu_root"
            action="sale_order_inherit_action"
            sequence="20"/>
    </data>
</odoo>