<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="dac_sale_order_custom_view_form" model="ir.ui.view">
            <field name="name">sale.order.custom.form</field>
            <field name="model">sale.order</field>
            <field name="priority">1</field> <!-- Ưu tiên view này -->
            <field name="arch" type="xml">
                <form string="Báo giá">
                    <header>
                        <field name="order_state_custom" 
                                widget="statusbar" 
                                statusbar_visible="quotation,deposit,production,delivery,payment,completed"
                                statusbar_colors='{"cancel":"red"}'
                            />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="check_and_add_deposit_line"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-refresh"
                                    string="Kiểm tra cọc"
                                    help="Kiểm tra và thêm dòng đặt cọc nếu có hóa đơn cọc đã thanh toán"
                                    invisible="deposit_invoice_count == 0"/>
                            <button name="debug_deposit_info"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-bug"
                                    string="Debug cọc"
                                    help="Debug thông tin đặt cọc và log chi tiết"
                                    groups="base.group_system"/>
                            <button name="check_and_update_completion_status"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-refresh"
                                    string="Cập nhật"
                                    help="Kiểm tra, cập nhật trạng thái và tải lại view"
                                    groups="base.group_system"/>
                            <button name="action_reset_completion_status_if_only_deposit"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-undo"
                                    string="Reset"
                                    help="Reset trạng thái nếu đơn bị set sai khi chỉ thanh toán cọc"
                                    groups="base.group_system"/>
                            <button name="action_view_conversations"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-comments"
                                    invisible="conversation_count == 0">
                                <field name="conversation_count" widget="statinfo" string="Conversations"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <field name="has_paid_deposit_invoice" invisible="1"/>
                        <field name="deposit_invoice_count" invisible="1"/>
                        <field name="total_invoice_count" invisible="1"/>
                        <field name="has_final_invoice" invisible="1"/>
                        <field name="can_delete_products" invisible="1"/>
                        <field name="conversation_count" invisible="1"/>
                        <group name="sale_header">
                            <group name="partner_details">
                                <field name="partner_id" options="{'no_create_edit': True}" context="{'show_address': 1, 'show_vat': True}"/>
                                <field name="phone" 
                                       string="Số điện thoại"
                                       placeholder="Số điện thoại"
                                       />
                                <!-- Trường địa chỉ giao hàng - hiện từ tiến trình giao hàng -->
                                <field name="delivery_address" 
                                       string="Địa chỉ giao hàng"
                                       invisible="order_state_custom not in ['delivery', 'payment']"
                                       readonly="is_delivery_confirmed"
                                       widget="text"/>
                                <!-- Số đơn trên excel -->
                                <field name="order_number"
                                       string="Số đặt hàng"
                                       placeholder="VD: 8766"
                                       />
                                <field name="is_priority" 
                                        string="Ưu tiên" 
                                        widget="boolean_toggle"/>
                                <field name="is_priority_today" 
                                        string="Ưu tiên trong ngày" 
                                        widget="boolean_toggle" 
                                        readonly="not is_priority"
                                        invisible="not is_priority"/>
                            </group>
                            <group>
                                <!-- Hiển thị thông tin Sale, Thiết kế, Sản xuất -->
                                <field name="user_id" 
                                       widget="many2one_avatar_user" 
                                       string="Sale phụ trách"
                                       /> 
                                <!-- Thiết kế -->
                                <field name="user_id_design"
                                       widget="many2one_avatar_user"
                                       string="Người thiết kế"
                                       />
                                       
                                <!-- Sản xuất -->
                                <field name="user_id_production"
                                       widget="many2one_avatar_user"
                                       string="Người sản xuất"
                                       />

                                <!-- Nhóm sản xuất -->
                                <field name="production_group_ids"
                                       widget="many2many_tags"
                                       string="Nhóm sản xuất"
                                       /> <!-- thêm domain="[('id','!=', user_id_production)]" nếu không để người phụ trách sản xuất vào-->
                            </group>
                        </group>
                        <group>
                            <group>
                                <separator string="Đặt cọc &amp; Thiết kế" invisible="order_state_custom == 'quotation'"/>
                                <field name="design_link" 
                                    string="Link thiết kế" 
                                    placeholder="Điền link thiết kế ở đây (Google Drive, Figma, v.v.)" 
                                    invisible="order_state_custom == 'quotation'"/>
                                <field name="has_deposit"
                                       invisible="order_state_custom == 'quotation' and not is_deposit_confirmed"
                                       readonly="is_deposit_confirmed or order_state_custom != 'deposit' or is_production_confirmed"/>
                                <!-- Div tiền cọc: Luôn hiện ở mọi tiến trình trừ báo giá đầu tiên, chỉ ẩn nếu không có cọc hoặc đang ở quotation -->
                                <div invisible="(order_state_custom == 'quotation' and not is_deposit_confirmed) or not has_deposit" 
                                style="max-width: 500px; margin-bottom: 8px;">
                                    <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
                                        <label for="deposit_amount" style="font-weight: 600; font-size: 14px; color: #007bff; margin-bottom: 0; min-width: 70px; white-space: nowrap;">Tiền cọc</label>
                                        <div style="display: flex; align-items: center; justify-content: center; background: #fffbe6; border-radius: 5px; border: 1px solid #ffe066; width: 180px; padding: 3px 6px;">
                                            <div style="display: flex; align-items: center; width: 100%; justify-content: center;">
                                                <field name="deposit_amount"
                                                       style="font-size: 1.08rem; font-weight: 600; color: #e55353; text-align: center; border: none; background: transparent; width: 100%; min-width: 0; max-width: 100%; padding: 0; margin: 0; letter-spacing: 0.2px;"
                                                       readonly="is_deposit_confirmed"
                                                       widget="integer"/>
                                                <span style="font-size: 1.08rem; font-weight: 600; color: #e55353; margin-left: 4px;">đ</span>
                                            </div>
                                        </div>
                                        <button name="action_deposit_invoice"
                                            string="Lên cọc"
                                            type="object"
                                            class="btn btn-success"
                                            style="min-width: 70px; font-size: 0.98rem; font-weight: 600; padding: 7px 0; margin-left: 8px;"
                                            invisible="not (order_state_custom == 'deposit' and has_deposit and not is_deposit_confirmed)"/>
                                        <!-- Nút Xem hóa đơn cho đơn CÓ cọc - nằm cùng hàng -->
                                        <button name="action_view_all_invoices"
                                            string="Xem hóa đơn"
                                            type="object"
                                            class="btn btn-success"
                                            style="min-width: 80px; font-size: 0.98rem; font-weight: 600; padding: 7px 0; margin-left: 8px;"
                                            invisible="total_invoice_count == 0"/>
                                    </div>
                                </div>
                                <!-- Nút Xem hóa đơn cho đơn KHÔNG cọc - hiện riêng lẻ và đẹp hơn -->
                                <div style="margin-bottom: 8px;" invisible="has_deposit or total_invoice_count == 0">
                                    <button name="action_view_all_invoices"
                                        string="Xem hóa đơn"
                                        type="object"
                                        class="btn btn-success"
                                        style="min-width: 80px; font-size: 0.98rem; font-weight: 600; padding: 7px 0;"/>
                                </div>
                            </group>
                            <group>
                                <separator string="Sản xuất" invisible="order_state_custom == 'quotation'"/>
                                <field name="production_image" 
                                       string="Hình ảnh" 
                                       widget="image"
                                       class="oe_avatar"
                                       invisible="order_state_custom == 'quotation'"
                                       style="max-width: 360px; max-height: 360px;"/>
                                <!-- Nút tiện ích cho ảnh -->
                                <button name="action_view_production_image"
                                        type="object"
                                        class="btn btn-secondary"
                                        invisible="not production_image">
                                    <i class="fa fa-external-link" style="margin-right:6px;"/>
                                    <span>Xem ảnh</span>
                                </button>

                                <!-- Nút Tải ảnh -->
                                <button name="action_download_production_image"
                                        type="object"
                                        class="btn btn-secondary"
                                        invisible="not production_image">
                                    <i class="fa fa-download" style="margin-right:6px;"/>
                                    <span>Tải xuống</span>
                                </button>
                                <!-- Trường deadline sản xuất - thiết kế lại: luôn nằm trên, điều kiện invisible gốc, giao diện hài hòa -->
                                <div invisible="order_state_custom == 'quotation' and not is_deposit_confirmed"
                                     style="margin-bottom: 8px; display: flex; align-items: center; gap: 6px; background: #fffbe6; border: 1px solid #ffc107; border-radius: 5px; padding: 4px 10px; width: fit-content;">
                                    <i class="fa fa-calendar" style="color: #ffc107;"></i>
                                    <span class="o_form_label" style="font-weight: 600; color: #e55353; font-size: 13px;">Ngày dự kiến hoàn tất sản xuất</span>
                                    <field name="production_deadline"
                                           placeholder="VD: 01/09/2025"
                                           style="font-size: 1em; font-weight: 600; color: #007bff; width: 120px; background: #fff; border: 1px solid #007bff; border-radius: 3px; padding: 2px 8px; margin-left: 6px;"/>
                                </div>
                                <!-- Trường hợp sản xuất bị trễ -->
                                <field name="production_is_delayed"
                                       string="Có trễ không?"
                                       widget="boolean_toggle"
                                       invisible="(order_state_custom in ['quotation','deposit']) and (not started_delivery)"
                                       readonly="order_state_custom != 'production' or started_delivery"/>
                                <field name="production_delay_date"
                                       string="Ngày trễ"
                                       invisible="(not production_is_delayed) or ((order_state_custom in ['quotation','deposit']) and (not started_delivery))"
                                       readonly="order_state_custom != 'production' or started_delivery"/>
                                <field name="production_delay_reason"
                                       string="Lý do trễ"
                                       widget="text"
                                       placeholder="Hãy điền nguyên nhân trễ…"
                                       invisible="(not production_is_delayed) or ((order_state_custom in ['quotation','deposit']) and (not started_delivery))"
                                       readonly="order_state_custom != 'production' or started_delivery"/>
                                       
                                <!-- Nút đánh dấu hoàn thành sản xuất -->
                                <button name="action_mark_production_done"
                                        type="object"
                                        string="Hoàn thành sản xuất"
                                        class="btn btn-success"
                                        groups="dac_erp.group_dac_erp_production,dac_erp.group_dac_erp_manager,base.group_system"
                                        invisible="order_state_custom != 'production' or not is_production_confirmed or production_done"/>


                                <field name="production_done" invisible="order_state_custom != 'production' or not is_production_confirmed or not production_done" readonly="1"/>
                                <field name="production_done_user_id" invisible="1"/>
                                <field name="production_done_date" invisible="1"/>
                            </group> 
                        </group>
                        <notebook>
                            <page string="Chi tiết đơn hàng">
                                <field name="order_line" widget="section_and_note_one2many" mode="list,kanban" 
                                       readonly="state == 'cancel' or locked"
                                       can_delete="can_delete_products"
                                       context="{'list_view_ref': 'dac_erp.sale_order_line_list_view'}">
                                    <list editable="bottom">
                                        <!-- Phần control để thêm ghi chú -->
                                        <control>
                                            <create name="add_product_control" string="Thêm sản phẩm"/>
                                            <!-- <create name="add_section_control" string="Thêm đầu mục" context="{'default_display_type': 'line_section'}"/> -->
                                            <create name="add_note_control" string="Thêm ghi chú" context="{'default_display_type': 'line_note'}"/>
                                        </control>
                                        <field name="sequence" widget="handle" optional="show"/>
                                        <field name="product_id" string="Sản phẩm" invisible="display_type" 
                                               options="{'no_create_edit': False, 'can_create': True, 'can_write': True}"/>
                                        <field name="description" string="Nội dung" invisible="display_type"/>
                                        <field name="height" string="Chiều cao" invisible="display_type"/>
                                        <field name="width" string="Chiều ngang" invisible="display_type"/>
                                        <field name="product_uom_qty" string="Số lượng" invisible="display_type"/>
                                        <field name="price_unit" string="Đơn giá" invisible="display_type"/>
                                        <field name="tax_id" string="Thuế" widget="many2many_tags" invisible="display_type"/>
                                        <field name="price_subtotal" string="Thành tiền" readonly="1" invisible="display_type"/>
                                        <!-- Hiển thị name CHỈ khi là dòng section/note và giữ cột này không trong menu tùy chọn -->
                                         <field name="name" 
                                               string=""
                                               width="1px"
                                               invisible="not display_type" 
                                               decoration-bf="display_type == 'line_section'" 
                                               decoration-it="display_type == 'line_note'"
                                               required="display_type in ['line_section', 'line_note']"
                                               widget="sol_text"/> <!-- Thêm widget này -->
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <!-- <div style="text-align: left; margin-top: 24px;">
                            <field name="note" placeholder="Ghi chú" nolabel="1"/>
                        </div> -->
                        <div style="text-align: right; margin-top: 16px;">
                            <field name="currency_id" invisible="1"/>
                            <!-- Thành tiền (bắt buộc có) -->
                            <div>
                                <label for="amount_untaxed_original">Thành tiền:</label>
                                <span style="font-weight: bold; margin-left: 16px;">
                                    <field name="amount_untaxed_original" readonly="1" widget="monetary"/>
                                </span>
                            </div>
                            <!-- Thuế (bắt buộc có) -->
                            <div>
                                <label for="amount_tax">Thuế:</label>
                                <span style="font-weight: bold; margin-left: 16px;">
                                    <field name="amount_tax" readonly="1" widget="monetary"/>
                                </span>
                            </div>
                            <!-- Tiền cọc (tùy đơn hàng có cọc hay không) -->
                            <div invisible="total_deposit_paid == 0">
                                <label for="total_deposit_paid">Tiền cọc đã thanh toán:</label>
                                <span style="font-weight: bold; margin-left: 16px; color: green;">
                                    <field name="total_deposit_paid" readonly="1" widget="monetary"/>
                                </span>
                            </div>
                            <!-- Số tiền còn lại cần thu (phụ thuộc vào tổng và cọc) -->
                            <div invisible="is_order_completed or remaining_amount_display == 0">
                                <label for="remaining_amount_display">Còn lại cần thu:</label>
                                <span style="font-weight: bold; margin-left: 16px; color: #e55353;">
                                    <field name="remaining_amount_display" readonly="1" widget="monetary"/>
                                </span>
                            </div>
                            <!-- Tổng (bắt buộc có, không thay đổi) -->
                            <div>
                                <span style="font-weight: bold; font-size: 1.5em;" invisible="is_order_completed">
                                    Tổng:
                                    <field name="amount_total" readonly="1" widget="monetary"/>
                                </span>
                                <span style="font-weight: bold; font-size: 1.5em; color: green;" invisible="not is_order_completed">
                                    Tổng (Đã hoàn thành):
                                    <field name="amount_total" readonly="1" widget="monetary"/>
                                </span>
                            </div>
                            <div invisible="not is_order_completed" style="text-align: center; padding: 10px; background-color: #d4edda; border: 1px solid #c3e6cb; border-radius: 5px; margin: 10px 0;">
                                <span style="font-weight: bold; color: #155724; font-size: 1.2em;">
                                    Đơn hàng đã thanh toán
                                </span>
                            </div>
                            <div invisible="order_state_custom != 'cancel'" style="text-align: center; padding: 10px; background-color: #f8d7da; border: 1px solid #f5c6cb; border-radius: 5px; margin: 10px 0;">
                                <span style="font-weight: bold; color: #721c24; font-size: 1.2em;">
                                    Đơn hàng đã hủy
                                </span>
                            </div>
                            <field name="is_order_completed" invisible="1"/>
                            <field name="remaining_amount_display" invisible="1"/>
                            <div style="display: flex; gap: 16px; justify-content: flex-end; margin-top: 16px;">
                                <!-- Nút Hủy đơn hàng - chỉ hiện ở trạng thái báo giá và đã lưu và chưa có hóa đơn cọc -->
                                <button name="action_cancel_order"
                                    string="Hủy đơn hàng"
                                    type="object"
                                    class="btn-danger"
                                    invisible="not id or order_state_custom != 'quotation' or deposit_invoice_count > 0"
                                    confirm="Bạn có chắc chắn muốn hủy đơn hàng này không?"/>

                                <!-- Nút Lưu -->
                                <button name="action_save_custom"
                                    string="Lưu" 
                                    type="object"  
                                    class="btn-primary"
                                    invisible="is_order_completed or order_state_custom == 'cancel'"/>

                                <!-- Nút Quay lại tiến trình trước: Dùng chung cho mọi tiến trình (trừ báo giá) -->
                                <button name="action_back_custom_step"
                                    string="Quay lại"
                                    type="object"
                                    class="btn-secondary"
                                    invisible="order_state_custom == 'quotation' or is_order_completed or order_state_custom == 'cancel'"/>

                                <!-- Nút Xác nhận cho tiến trình báo giá -->
                                <button name="action_confirm_info"
                                    string="Xác nhận"
                                    type="object"
                                    class="btn-warning"
                                    invisible="
                                        order_state_custom != 'quotation'
                                        or is_quotation_confirmed
                                    "/>

                                <!-- Nút "Tiến hành sản xuất" cho trạng thái deposit với logic mới -->
                                <button name="action_proceed_to_production"
                                    string="Tiến hành sản xuất"
                                    type="object"
                                    class="btn-primary"
                                    context="{'from_ui_button': True}"
                                    invisible="
                                        order_state_custom != 'deposit'
                                        or not production_deadline
                                        or (has_deposit and (not is_deposit_confirmed or not has_paid_deposit_invoice))
                                    "/>

                                <!-- Nút "Tiến hành giao hàng" cho trạng thái production -->
                                <button name="action_proceed_to_delivery"
                                    string="Tiến hành giao hàng"
                                    type="object"
                                    class="btn-primary"
                                    invisible="order_state_custom != 'production' or not is_production_confirmed"/>

                                <!-- Nút Xác nhận cho các tiến trình khác (chỉ delivery) -->
                                <button name="action_confirm_info"
                                    string="Xác nhận"
                                    type="object"
                                    class="btn-warning"
                                    invisible="
                                        order_state_custom != 'delivery'
                                        or is_delivery_confirmed
                                    "/>

                                <!-- Nút Tạo hóa đơn ở bước cuối cùng (payment) -->
                                <button name="action_create_final_invoice"
                                    string="Tạo hóa đơn"
                                    type="object"
                                    class="btn-success"
                                    invisible="order_state_custom != 'payment' or is_payment_confirmed or has_final_invoice"/>

                                <!-- Nút Chuyển sang tiến trình tiếp theo: Đặt cọc -->
                                <button name="action_next_step"
                                    string="Đặt cọc"
                                    type="object"
                                    class="btn-primary"
                                    invisible="order_state_custom != 'quotation' or not is_quotation_confirmed"/>
                                    
                                <!-- Nút Chuyển sang tiến trình tiếp theo: Thu tiền -->
                                <!-- Bỏ nút Giao hàng vì đã có nút "Tiến hành giao hàng" riêng -->
                                <button name="action_next_step"
                                    string="Thu tiền"
                                    type="object"
                                    class="btn-primary"
                                    invisible="order_state_custom != 'delivery' or not is_delivery_confirmed"/>
                                <!-- Nút Chuyển sang tiến trình tiếp theo: Ẩn ở bước cuối cùng -->
                                <!-- Không cần nút cho bước 'payment' vì không có bước tiếp theo -->
                            </div>
                        </div>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- View để ẩn button tự động của Odoo -->
        <record id="dac_sale_order_hide_auto_buttons" model="ir.ui.view">
            <field name="name">sale.order.hide.auto.buttons</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_view_invoice']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <!-- List view cho Sale users - không cho delete -->
        <record id="dac_sale_order_custom_view_list_sale" model="ir.ui.view">
            <field name="name">sale.order.custom.list.sale</field>
            <field name="model">sale.order</field>
            <field name="priority">2</field>
            <field name="groups_id" eval="[(6, 0, [ref('dac_erp.group_dac_erp_sale')])]"/>
            <field name="arch" type="xml">
                <list string="Báo giá" default_order="date desc" delete="false" create="true" edit="true">
                    <field name="latest_quotation_info" string="Báo giá mới nhất" readonly="1" optional="hide"/>
                    <field name="name" optional="hide"/>
                    <field name="company_id" invisible="1" optional="hide"/>
                    <field name="currency_id" invisible="1" optional="hide"/>
                    <field name="pricelist_id" invisible="1" optional="hide"/>
                    <field name="create_date" string="Ngày tạo đơn (hệ thống)" optional="hide"/>
                    <field name="order_number" string="Số phiếu ĐH"/>
                    <field name="date" string="Ngày đơn hàng"/>
                    <field name="partner_id" />
                    <field name="user_id" widget="many2one_avatar_user" string="Sale phụ trách"/>
                    <field name="user_id_design" widget="many2one_avatar_user" string="Người thiết kế"/>
                    <field name="user_id_production" widget="many2one_avatar_user" string="Người sản xuất"/>
                    <field name="amount_total" sum="Total" widget="monetary"/>
                    <field name="order_state_custom" widget="badge" string="Trạng thái"
                        decoration-info="order_state_custom == 'quotation' and not is_order_completed"
                        decoration-warning="order_state_custom == 'deposit' and not is_order_completed"
                        decoration-primary="order_state_custom in ['production', 'delivery'] and not is_order_completed"
                        decoration-success="order_state_custom == 'payment' and not is_order_completed"
                        decoration-muted="is_order_completed or order_state_custom == 'completed'"
                        decoration-danger="order_state_custom == 'cancel'"/>
                    <field name="is_priority" string="Ưu tiên"/>
                    <field name="is_priority_today" string="Trong ngày"/>
                    <field name="production_deadline" string="Ngày hoàn tất sản xuất"/>
                </list>
            </field>
        </record>

        <!-- List view cho Manager - có full quyền -->
        <record id="dac_sale_order_custom_view_list" model="ir.ui.view">
            <field name="name">sale.order.custom.list</field>
            <field name="model">sale.order</field>
            <field name="priority">1</field>
            <field name="groups_id" eval="[(6, 0, [ref('dac_erp.group_dac_erp_manager')])]"/>
            <field name="arch" type="xml">
                <list string="Báo giá" default_order="date desc" delete="true" create="true" edit="true">
                    <field name="latest_quotation_info" string="Báo giá mới nhất" readonly="1" optional="hide"/>
                    <field name="name" optional="hide"/>
                    <field name="company_id" invisible="1" optional="hide"/>
                    <field name="currency_id" invisible="1" optional="hide"/>
                    <field name="pricelist_id" invisible="1" optional="hide"/>
                    
                    <field name="create_date" string="Ngày tạo đơn (hệ thống)" optional="hide"/>
                    <field name="order_number" string="Số phiếu ĐH"/>
                    <field name="date" string="Ngày đơn hàng"/>
                    <field name="partner_id"/>
                    <field name="user_id" widget="many2one_avatar_user" string="Sale phụ trách"/>
                    <field name="user_id_design" widget="many2one_avatar_user" string="Người thiết kế"/>
                    <field name="user_id_production" widget="many2one_avatar_user" string="Người sản xuất"/>
                    <field name="amount_total" sum="Total" widget="monetary"/>
                    <field name="order_state_custom" widget="badge" string="Trạng thái"
                        decoration-info="order_state_custom == 'quotation' and not is_order_completed"
                        decoration-warning="order_state_custom == 'deposit' and not is_order_completed"
                        decoration-primary="order_state_custom in ['production', 'delivery'] and not is_order_completed"
                        decoration-success="order_state_custom == 'payment' and not is_order_completed"
                        decoration-muted="is_order_completed or order_state_custom == 'completed'"
                        decoration-danger="order_state_custom == 'cancel'"/>
                    <field name="is_priority" string="Ưu tiên"/>
                    <field name="is_priority_today" string="Trong ngày"/>
                    <field name="production_deadline" string="Ngày hoàn tất sản xuất"/>
                </list>
            </field>
        </record>

        <record id="dac_sale_order_custom_search" model="ir.ui.view">
            <field name="name">sale.order.custom.search</field>
            <field name="model">sale.order</field>
            <field name="arch" type="xml">
                <search string="Tìm kiếm báo giá">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="user_id"/>
                    <field name="order_state_custom"/>
                    <filter string="Báo giá" name="quotation" domain="[('order_state_custom', '=', 'quotation')]"/>
                    <filter string="Đặt cọc" name="deposit" domain="[('order_state_custom', '=', 'deposit')]"/>
                    <filter string="Sản xuất" name="production" domain="[('order_state_custom', '=', 'production')]"/>
                    <filter string="Giao hàng" name="delivery" domain="[('order_state_custom', '=', 'delivery')]"/>
                    <filter string="Thu tiền" name="payment" domain="[('order_state_custom', '=', 'payment')]"/>
                    <separator/>
                    <filter string="Đã hoàn thành" name="completed" domain="[('is_order_completed', '=', True)]"/>
                    <filter string="Chưa hoàn thành" name="not_completed" domain="[('is_order_completed', '=', False)]"/>
                    <group expand="1" string="Nhóm theo">
                        <filter string="Trạng thái" name="group_by_state" context="{'group_by': 'order_state_custom'}"/>
                        <filter string="Sale phụ trách" name="group_by_user" context="{'group_by': 'user_id'}"/>
                        <filter string="Người thiết kế" name="group_by_user_design" context="{'group_by': 'user_id_design'}"/>
                        <filter string="Người sản xuất" name="group_by_user_production" context="{'group_by': 'user_id_production'}"/>
                        <filter string="Khách hàng" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                        <filter string="Thời gian tạo" name="group_by_date" context="{'group_by': 'date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="dac_sale_order_custom_action" model="ir.actions.act_window">
            <field name="name">Đơn hàng</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="dac_sale_order_custom_view_list_sale"/>
            <field name="search_view_id" ref="dac_sale_order_custom_search"/>
            <field name="context">{}</field>
            <field name="domain">[('user_id', '=', uid)]</field>
            <field name="groups_id" eval="[(6, 0, [ref('dac_erp.group_dac_erp_sale')])]"/>
        </record>

        <!-- Action riêng cho Manager - xem tất cả đơn hàng -->
        <record id="dac_sale_order_manager_action" model="ir.actions.act_window">
            <field name="name">Đơn hàng</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="dac_sale_order_custom_view_list"/>
            <field name="search_view_id" ref="dac_sale_order_custom_search"/>
            <field name="context">{}</field>
            <field name="groups_id" eval="[(6, 0, [ref('dac_erp.group_dac_erp_manager')])]"/>
        </record>


        <!-- View riêng cho sale.order.line với khả năng import -->
        <record id="sale_order_line_tree_import" model="ir.ui.view">
            <field name="name">sale.order.line.tree.import</field>
            <field name="model">sale.order.line</field>
            <field name="arch" type="xml">
                <list string="Dòng đơn hàng" create="true" import="true">
                    <field name="order_id" string="Đơn hàng"/>
                    <field name="sequence" widget="handle"/>
                    <field name="product_id" string="Sản phẩm"/>
                    <field name="name" string="Mô tả"/>
                    <field name="product_uom_qty" string="Số lượng"/>
                    <field name="price_unit" string="Đơn giá"/>
                    <field name="product_uom" string="Đơn vị tính"/>
                    <field name="price_subtotal" string="Thành tiền" sum="Tổng"/>
                    <field name="display_type" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Action để import Sale Order Lines -->
        <record id="action_sale_order_line_import" model="ir.actions.act_window">
            <field name="name">Dòng đơn hàng</field>
            <field name="res_model">sale.order.line</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="sale_order_line_tree_import"/>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Không có dòng đơn hàng nào!
                </p>
                <p>
                    Bạn có thể import dữ liệu bằng cách nhấn nút "Import" ở trên.
                </p>
            </field>
        </record>
    </data>
</odoo>