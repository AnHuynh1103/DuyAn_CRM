<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============== PANCAKE PAGE VIEWS ============== -->
        
        <!-- List View for Pages -->
        <record id="pancake_page_view_list" model="ir.ui.view">
            <field name="name">pancake.page.list</field>
            <field name="model">pancake.page</field>
            <field name="arch" type="xml">
                <list string="Pancake Pages" default_order="name asc">
                    <field name="name"/>
                    <field name="page_id"/>
                    <field name="active" widget="boolean_toggle"/>
                    <field name="conversation_count"/>
                </list>
            </field>
        </record>

        <!-- Form View for Pages -->
        <record id="pancake_page_view_form" model="ir.ui.view">
            <field name="name">pancake.page.form</field>
            <field name="model">pancake.page</field>
            <field name="arch" type="xml">
                <form string="Pancake Page">
                    <header>
                        <button name="action_sync_conversations" type="object" string="Đồng bộ cuộc hội thoại" class="btn-primary"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_conversations" type="object" class="oe_stat_button" icon="fa-comments">
                                <field name="conversation_count" widget="statinfo" string="Cuộc hội thoại"/>
                            </button>
                        </div>
                        
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="page_id"/>
                                <field name="active"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Cuộc hội thoại">
                                <field name="conversation_ids" readonly="1">
                                    <list>
                                        <field name="customer_name"/>
                                        <field name="platform"/>
                                        <field name="last_message_content"/>
                                        <field name="last_message_time"/>
                                        <field name="conversation_type"/>
                                        <field name="message_count"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View for Pages -->
        <record id="pancake_page_view_search" model="ir.ui.view">
            <field name="name">pancake.page.search</field>
            <field name="model">pancake.page</field>
            <field name="arch" type="xml">
                <search string="Tìm kiếm Page">
                    <field name="name"/>
                    <field name="page_id"/>
                    
                    <filter string="Đang hoạt động" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Không hoạt động" name="inactive" domain="[('active', '=', False)]"/>
                    
                    <group expand="1" string="Nhóm theo">
                        <filter string="Trạng thái" name="group_by_active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============== PANCAKE CONVERSATION VIEWS ============== -->
        
        <!-- List View for Conversations -->
        <record id="pancake_page_conversation_view_list" model="ir.ui.view">
            <field name="name">pancake.page.conversation.list</field>
            <field name="model">pancake.page.conversation</field>
            <field name="arch" type="xml">
                <list string="Pancake Conversations" default_order="last_message_time desc">
                    <field name="customer_name"/>
                    <field name="page_id"/>
                    <field name="platform" widget="badge"/>
                    <field name="conversation_type" widget="badge"/>
                    <field name="last_message_content"/>
                    <field name="last_message_time"/>
                    <field name="message_count"/>
                    <field name="partner_id"/>
                </list>
            </field>
        </record>

        <!-- Form View for Conversations -->
        <record id="pancake_page_conversation_view_form" model="ir.ui.view">
            <field name="name">pancake.page.conversation.form</field>
            <field name="model">pancake.page.conversation</field>
            <field name="arch" type="xml">
                <form string="Pancake Conversation">
                    <header>
                        <button name="action_sync_messages" type="object" string="Đồng bộ tin nhắn" class="btn-primary"/>
                        <button name="action_create_partner" type="object" string="Tạo Partner" class="btn-secondary" invisible="partner_id"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_messages" type="object" class="oe_stat_button" icon="fa-envelope">
                                <field name="message_count" widget="statinfo" string="Tin nhắn"/>
                            </button>
                        </div>
                        
                        <div class="oe_title">
                            <h1>
                                <field name="customer_name"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group name="conversation_info" string="Thông tin cuộc hội thoại">
                                <field name="conversation_id"/>
                                <field name="page_id"/>
                                <field name="platform"/>
                                <field name="conversation_type"/>
                                <field name="partner_id"/>
                            </group>
                            
                            <group name="customer_info" string="Thông tin khách hàng">
                                <field name="customer_name"/>
                                <field name="customer_email"/>
                                <field name="customer_phone"/>
                            </group>
                        </group>
                        
                        <group>
                            <group name="message_info" string="Tin nhắn cuối">
                                <field name="last_message_content"/>
                                <field name="last_message_sender"/>
                                <field name="last_message_time"/>
                            </group>
                            
                            <group name="sync_info" string="Thông tin đồng bộ">
                                <field name="last_sync_time"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Tin nhắn">
                                <field name="message_ids" readonly="1">
                                    <list>
                                        <field name="inserted_at"/>
                                        <field name="sender_name"/>
                                        <field name="is_from_customer" widget="boolean_toggle"/>
                                        <field name="message_type"/>
                                        <field name="content"/>
                                        <field name="has_phone" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                            
                            <page string="Tags &amp; Raw Data">
                                <group>
                                    <field name="tags" widget="text"/>
                                </group>
                                <group>
                                    <field name="raw_data" widget="text"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View for Conversations -->
        <record id="pancake_page_conversation_view_search" model="ir.ui.view">
            <field name="name">pancake.page.conversation.search</field>
            <field name="model">pancake.page.conversation</field>
            <field name="arch" type="xml">
                <search string="Tìm kiếm cuộc hội thoại">
                    <field name="customer_name"/>
                    <field name="customer_email"/>
                    <field name="customer_phone"/>
                    <field name="platform"/>
                    <field name="conversation_type"/>
                    
                    <filter string="Từ khách hàng" name="from_customer" domain="[('last_message_sender', '=', 'customer')]"/>
                    <filter string="Từ fanpage" name="from_page" domain="[('last_message_sender', '=', 'page')]"/>
                    
                    <group expand="1" string="Nhóm theo">
                        <filter string="Platform" name="group_by_platform" context="{'group_by': 'platform'}"/>
                        <filter string="Loại cuộc hội thoại" name="group_by_type" context="{'group_by': 'conversation_type'}"/>
                        <filter string="Page" name="group_by_page" context="{'group_by': 'page_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============== PANCAKE MESSAGE VIEWS ============== -->
        
        <!-- List View for Messages -->
        <record id="pancake_page_conversation_message_view_list" model="ir.ui.view">
            <field name="name">pancake.page.conversation.message.list</field>
            <field name="model">pancake.page.conversation.message</field>
            <field name="arch" type="xml">
                <list string="Pancake Messages" default_order="inserted_at desc">
                    <field name="inserted_at"/>
                    <field name="sender_name"/>
                    <field name="is_from_customer" widget="boolean_toggle"/>
                    <field name="message_type"/>
                    <field name="content"/>
                    <field name="has_phone" widget="boolean_toggle"/>
                    <field name="conversation_id"/>
                </list>
            </field>
        </record>

        <!-- Form View for Messages -->
        <record id="pancake_page_conversation_message_view_form" model="ir.ui.view">
            <field name="name">pancake.page.conversation.message.form</field>
            <field name="model">pancake.page.conversation.message</field>
            <field name="arch" type="xml">
                <form string="Pancake Message">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="sender_name"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group name="message_info" string="Thông tin tin nhắn">
                                <field name="message_id"/>
                                <field name="conversation_id"/>
                                <field name="message_type"/>
                                <field name="is_from_customer"/>
                                <field name="has_phone"/>
                            </group>
                            
                            <group name="time_info" string="Thời gian">
                                <field name="inserted_at"/>
                            </group>
                        </group>
                        
                        <group>
                            <field name="content" widget="text"/>
                        </group>
                        
                        <notebook>
                            <page string="Raw Data">
                                <group>
                                    <field name="raw_data" widget="text"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============== ACTIONS &amp; MENUS ============== -->
        
        <!-- Action for Pages -->
        <record id="pancake_page_action" model="ir.actions.act_window">
            <field name="name">Pancake Pages</field>
            <field name="res_model">pancake.page</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="pancake_page_view_list"/>
            <field name="search_view_id" ref="pancake_page_view_search"/>
            <field name="context">{'search_default_active': 1}</field>
        </record>

        <!-- Action for Conversations -->
        <record id="pancake_page_conversation_action" model="ir.actions.act_window">
            <field name="name">Pancake Conversations</field>
            <field name="res_model">pancake.page.conversation</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="pancake_page_conversation_view_list"/>
            <field name="search_view_id" ref="pancake_page_conversation_view_search"/>
        </record>

        <!-- Action for Messages -->
        <record id="pancake_page_conversation_message_action" model="ir.actions.act_window">
            <field name="name">Pancake Messages</field>
            <field name="res_model">pancake.page.conversation.message</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="pancake_page_conversation_message_view_list"/>
        </record>

        <!-- Menu Items -->
        <menuitem id="pancake_menu_root"
                  name="Pancake"
                  sequence="25"/>

        <menuitem id="pancake_page_menu"
                  name="Pages"
                  parent="pancake_menu_root"
                  action="pancake_page_action"
                  sequence="10"/>

        <menuitem id="pancake_page_conversation_menu"
                  name="Cuộc hội thoại"
                  parent="pancake_menu_root"
                  action="pancake_page_conversation_action"
                  sequence="20"/>

        <menuitem id="pancake_page_conversation_message_menu"
                  name="Tin nhắn"
                  parent="pancake_menu_root"
                  action="pancake_page_conversation_message_action"
                  sequence="30"/>

    </data>
</odoo>
