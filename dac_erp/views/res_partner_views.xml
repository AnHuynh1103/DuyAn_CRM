<odoo>
  <data>
    <!-- Action cho Khách hàng -->
    <record id="dac_res_partner_customer_action" model="ir.actions.act_window">
      <field name="name">Khách hàng</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">kanban,list,form</field>
      <field name="domain"
       eval="['|',
               ('customer_rank','>',0),
               '|','|',
               ('email','!=',False),
               ('phone','!=',False),
               ('mobile','!=',False)
       ]"/>
    </record>

  </data>
</odoo>
