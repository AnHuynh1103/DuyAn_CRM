<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Cron job kiểm tra và đồng bộ dòng đặt cọc và trạng thái hoàn thành -->
        <record id="ir_cron_check_all_order_payment" model="ir.cron">
            <field name="name">Check All Orders Completion Status</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_deposit_payments()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
