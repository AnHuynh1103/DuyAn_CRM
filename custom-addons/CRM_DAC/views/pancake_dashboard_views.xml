<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pancake_dashboard_template" name="Pancake Dashboard">
        <t t-call="web.layout"> 
            <t t-set="html_data" t-value="{'o_web_client_allow_legacies': true}"/>
            <div class="container-fluid o_pancake_dashboard">
                <h1><t t-esc="page_title"/></h1>
                
                <div class="mb-3">
                    <button type="button" class="btn btn-primary" id="sync_all_pancake_orders_dashboard_btn">
                        <i class="fa fa-refresh"/> Đồng bộ tất cả đơn hàng Pancake
                    </button>
                    <div id="sync_status_message" class="mt-2"></div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Tổng số đơn hàng</h5>
                                <p class="card-text display-4"><t t-esc="total_orders"/></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Tổng doanh thu (COD)</h5>
                                <p class="card-text display-4"><t t-esc="total_revenue" t-options='{"widget": "monetary", "display_currency": request.env.company.currency_id}'/></p>
                            </div>
                        </div>
                    </div>
                     <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Đơn hàng theo trạng thái</h5>
                                <ul class="list-group">
                                    <t t-foreach="status_counts" t-as="status">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <t t-esc="status['pancake_status_name'] if status['pancake_status_name'] else 'Chưa xác định'"/>
                                            <span class="badge bg-primary rounded-pill"><t t-esc="status['pancake_status_name_count']"/></span>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <h3>Đơn hàng gần đây</h3>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Mã ĐH (Odoo)</th>
                                <th>Tên KH (Pancake)</th>
                                <th>Trạng thái (Pancake)</th>
                                <th>Ngày tạo (Pancake)</th>
                                <th>Tiền cần thu (Pancake)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="recent_orders" t-as="order">
                                <tr>
                                    <td><t t-esc="order['name']"/></td>
                                    <td><t t-esc="order['pancake_customer_name']"/></td>
                                    <td><t t-esc="order['pancake_status_name']"/></td>
                                    <td><t t-esc="order['pancake_inserted_at']"/></td>
                                    <td><t t-esc="order['pancake_money_to_collect']" t-options='{"widget": "monetary", "display_currency": request.env.company.currency_id}'/></td>
                                </tr>
                            </t>
                            <t t-if="not recent_orders">
                                <tr>
                                    <td colspan="5" class="text-center">Không có đơn hàng nào.</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
            
            <script type="text/javascript">
                //<![CDATA[
                odoo.define('CRM_DAC.pancake_dashboard_script', function (require) {
                    "use strict";
                    var ajax = require('web.ajax');
                    var Dialog = require('web.Dialog');

                    $('#sync_all_pancake_orders_dashboard_btn').on('click', function() {
                        var $btn = $(this);
                        // Khi sử dụng CDATA, bạn có thể viết chuỗi HTML trực tiếp
                        $btn.prop('disabled', true).prepend('<i class="fa fa-spinner fa-spin"></i> ');
                        $('#sync_status_message').html('');

                        ajax.jsonRpc('/pancake/trigger_sync_all', 'call', {})
                            .then(function(result) {
                                $btn.prop('disabled', false).find('.fa-spinner').remove();
                                if (result.status === 'success') {
                                    Dialog.alert(this, result.message, {title: "Thành công"});
                                    // Tùy chọn: reload lại trang hoặc cập nhật dữ liệu dashboard
                                    // window.location.reload(); 
                                } else {
                                    Dialog.alert(this, "Lỗi: " + result.message, {title: "Lỗi"});
                                }
                            }).guardedCatch(function (error) {
                                $btn.prop('disabled', false).find('.fa-spinner').remove();
                                var errorMessage = "Lỗi không xác định";
                                if (error.message && error.message.data && error.message.data.message) {
                                    errorMessage = error.message.data.message;
                                } else if (error.message && error.message.message) {
                                    errorMessage = error.message.message;
                                } else if (error.data && error.data.message) {
                                    errorMessage = error.data.message;
                                }
                                Dialog.alert(this, "Lỗi kết nối hoặc xử lý: " + errorMessage, {title: "Lỗi nghiêm trọng"});
                                console.error("RPC Query Error:", error);
                            });
                    });
                });
                //]]>
            </script>
        </t>
    </template>
    
    
</odoo>